{"run_id": "20261021-a0341536e295", "tag": "vsr", "status": "content_pending", "paper_count": 100, "as_of": "2026-10-21", "updated_at": "2026-10-21T08:10:06.139635+00:00", "mode": "90", "result_count": 100, "content_done": 10, "content_pending": 90, "guide_status": "not_required", "export_path": "docs/starter-pack/20261021-a0341536e295/papers.md", "selected_records": [{"id": "arxiv:2609.34148", "title": "Geometric Encoding for Spatial Reasoning in Vision-Language Models", "score": 9, "route": "20260723-20261020/2609.34148v1", "published": "2026-09-28", "publication_date": "2026-09-28", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.34148v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2608.02980", "title": "Qwen-3D: A Generalist 3D Vision-Language Model for Spatial Understanding", "score": 9, "route": "20260723-20261020/2608.02980v1", "published": "2026-08-04", "publication_date": "2026-08-04", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.02980v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "现有3D多模态大模型受限于以帧为中心的分词与语言式解码，难以兼顾长时序推理与稠密几何预测。Qwen-3D在Qwen主干中融合多视角几何线索压缩视觉流，并引入3D旋转位置编码，使注意力直接在3D场景空间运作。它还加入查询式分割解码器，将语言直接落地到3D场景表示，统一指代定位、实例分割与视觉问答。在多项基准上超越现有3D大模型及部分大型闭源2D模型，同时保持2D视觉语言性能。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.18694", "title": "GeoReader: Learning Latent Geometry for Spatial Reasoning in Vision-Language Models", "score": 9, "route": "20260723-20261020/2610.18694v1", "published": "2026-10-13", "publication_date": "2026-10-13", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.18694v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2607.21595", "title": "3D-Aware VLMs with Implicit and Explicit Geometries", "score": 9, "route": "20260723-20261020/2607.21595v1", "published": "2026-07-23", "publication_date": "2026-07-23", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2607.21595v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "现有基于2D输入的视觉语言模型难以完成需要细粒度空间理解与推理的3D任务。VLM-IE3D从RGB视频中同时学习隐式与显式3D几何，引入隐式几何token与显式几何token，并用3D感知适配器与2D视觉线索融合。在3D视频检测、3D视觉定位、3D密集描述和空间推理上均取得更优表现。该纯RGB设计无需额外3D输入即可注入强3D归纳偏置。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.22356", "title": "DK-VLM: Geometry as Position for Spatial Reasoning in Vision-Language Models", "score": 9, "route": "20260723-20261020/2610.22356v1", "published": "2026-10-15", "publication_date": "2026-10-15", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.22356v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2608.10864", "title": "Multi-View Relational Distillation for Spatial Reasoning with Vision-Language Models", "score": 9, "route": "20260723-20261020/2608.10864v1", "published": "2026-08-11", "publication_date": "2026-08-11", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.10864v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "视觉语言模型在空间推理上几何表征脆弱，现有微调或特征融合方案各有缺陷。本文提出多视图关系蒸馏MVRD，蒸馏跨视图patch余弦相似度而非教师特征本身。在多个代表性VLM上提升了视觉空间推理，优于监督微调和特征蒸馏，接近特征融合且参数与延迟更低。该方法兼顾几何性与语言对齐，并可泛化到3D场景理解任务。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.12355", "title": "Distilling Routed 3D Privilege for Spatial Reasoning in Vision-Language Models", "score": 9, "route": "20260723-20261020/2610.12355v2", "published": "2026-10-08", "publication_date": "2026-10-08", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.12355v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.05417", "title": "Render to Reason: Novel-View Semantic Prediction Improves Spatial Understanding in VLMs", "score": 9, "route": "20260723-20261020/2610.05417v1", "published": "2026-10-04", "publication_date": "2026-10-04", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.05417v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.37055", "title": "Spatial-OPSD: Self-Improving Spatial Reasoning via Label-Free Self-Distillation", "score": 9, "route": "20260723-20261020/2609.37055v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.37055v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.17844", "title": "What Makes a Good Visual Representation for Spatial Understanding in MLLMs?", "score": 9, "route": "20260723-20261020/2610.17844v1", "published": "2026-10-13", "publication_date": "2026-10-13", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.17844v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.32182", "title": "KeyRec: Bounded Visual Memory for Streaming and Long-Video Understanding", "score": 9, "route": "20260723-20261020/2609.32182v1", "published": "2026-09-26", "publication_date": "2026-09-26", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.32182v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "长视频与流式理解中，密集视觉token随视频时长累积，导致长上下文推理成本过高。KeyRec提出免训练的有界视觉记忆框架：写入阶段将近期细粒度观测存入视觉缓存，并把历史证据组织为结构化事件库，通过在线增—并—汰维护事件。提问时仅用文本路由器在近期与事件记忆间分配固定读取预算，无需重处理历史帧。在四个基准、三个VLM骨干上，仅用10%密集token预算即在15个设置中13个取得最佳压缩性能。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.18789", "title": "AdaGeoVLN: Selective Geometry Across Representation Depth and Navigation Time for Vision-Language Navigation", "score": 9, "route": "20260723-20261020/2609.18789v1", "published": "2026-09-16", "publication_date": "2026-09-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.18789v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "视觉语言导航需在时间维度上对齐语言与视觉并保持空间理解，但几何基础模型的多层表示如何被策略使用、历史几何证据如何保留尚不明确。AdaGeoVLN提出流式框架，将GFM早中晚多层表示与策略各阶段耦合，并按指令相关性、几何置信度与转移新颖性有界保留历史KV状态。在R2R-CE与RxR-CE上仅用单路RGB即取得强性能，消融显示多深度耦合显著优于重复注入末端特征。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.02091", "title": "GeoLatent: Geometry-Guided Latent Structuring with Routed Optimization for 3D Reasoning", "score": 9, "route": "20260723-20261020/2610.02091v1", "published": "2026-10-01", "publication_date": "2026-10-01", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.02091v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.22681", "title": "EgoP$^{2}$C: Internalizing Plan-Perceive-Compose for Spatial Reasoning in Egocentric Video", "score": 9, "route": "20260723-20261020/2610.22681v1", "published": "2026-10-15", "publication_date": "2026-10-15", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.22681v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2608.10278", "title": "Chain of Spatial Thoughts: Modality-Agnostic Spatial Grounding for Vision Language Models", "score": 9, "route": "20260723-20261020/2608.10278v1", "published": "2026-08-10", "publication_date": "2026-08-10", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.10278v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "视觉语言模型的空间理解对具身智能至关重要，但现有方法常需额外空间编码器或推理期架构改动，计算开销大。本文提出Space Tokens，将场景级3D几何与物体空间属性蒸馏为连续潜令牌，直接嵌入思维链推理。在VSI-Bench上Qwen3-VL-8B提升4.3%，物体尺寸与房间尺寸估计达最优。该轻量、可解释、架构无关的机制为VLM几何推理提供了高效方案。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.33616", "title": "SpatialSpeak: QA-Native Reconstruction with Local and Global Context for Spatial Chain-of-Thought Reasoning", "score": 9, "route": "20260723-20261020/2609.33616v1", "published": "2026-09-27", "publication_date": "2026-09-27", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.33616v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.04139", "title": "From Sight to Foresight: Predictive Spatial Reasoning in Vision-Language Models", "score": 9, "route": "20260723-20261020/2610.04139v1", "published": "2026-10-02", "publication_date": "2026-10-02", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.04139v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.36581", "title": "MemEvo: Automatic Discovery of Streaming Video Memory Mechanisms", "score": 9, "route": "20260723-20261020/2609.36581v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.36581v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.38177", "title": "Imagine3D-LLM: Teaching MLLMs to Imagine 3D Scenes Before Answering", "score": 9, "route": "20260723-20261020/2609.38177v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.38177v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2607.28312", "title": "ObjectStream: Latent Objects as Memory Anchors for Streaming Video Understanding", "score": 9, "route": "20260723-20261020/2607.28312v2", "published": "2026-07-30", "publication_date": "2026-07-30", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2607.28312v2", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "流式视频理解需在未知未来问题前持续保留视觉证据，现有方法按token重要性或时序冗余管理上下文，却少以持续演化的对象组织记忆。ObjectStream无需训练，从冻结Video-LLM表示中诱导空间连贯的潜在对象，跨帧链接为持久锚点并维护有界历史。在线评测中Qwen2.5-VL-7B实时视觉感知提升10.0分，峰值显存与首token时延降约50%；离线长视频丢弃82.5%视觉token仍超全token基线。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2608.10949", "title": "StreamFlow: Dynamic Memory Flows for Streaming Video Understanding", "score": 9, "route": "20260723-20261020/2608.10949v1", "published": "2026-08-11", "publication_date": "2026-08-11", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2608.10949v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "流式视频理解要求多模态大模型在严格因果与有限内存下保留关键证据，现有模型式方法需侵入式改骨干，记忆式方法则在冗余内容上浪费视觉编码且访问僵化。StreamFlow提出动态按需访问的视觉记忆框架，用轻量中期记忆在编码前过滤时序冗余，并以潜在长期记忆将历史视频压缩为可供推理的视觉潜变量。生成时由注意力引导检索在视觉依赖减弱时注入相关潜变量。其在StreamingBench达67.73%总体准确率，视觉注意力分数提升59.1%，端到端延迟与峰值内存分别降低50.4%和21.1%。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2610.17640", "title": "MemAct: Streaming Spatial Understanding with Memory and Active Exploration", "score": 9, "route": "20260723-20261020/2610.17640v1", "published": "2026-10-13", "publication_date": "2026-10-13", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.17640v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2610.23998", "title": "ProV-Mem: Proactive Memory for Streaming Video Question Answering", "score": 9, "route": "20260723-20261020/2610.23998v1", "published": "2026-10-15", "publication_date": "2026-10-15", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2610.23998v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.37035", "title": "Watch-Think-Interact: Bootstrapping Long-Horizon Multi-Turn Streaming Video Reasoning with Reinforcement Learning", "score": 9, "route": "20260723-20261020/2609.37035v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.37035v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "", "tags": [], "reading_status": "pending"}, {"id": "arxiv:2609.18540", "title": "SVMemAgent: A Streaming Video Memory Agent for Query-Agnostic Online Frame Selection", "score": 9, "route": "20260723-20261020/2609.18540v1", "published": "2026-09-16", "publication_date": "2026-09-16", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.18540v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary": "现有帧选择研究多为离线设定，需预先获得完整视频与查询。本文提出流式视频记忆SVMem及SVMemAgent，在未知时长、无查询与未来帧条件下，逐步决定保留或丢弃新帧以维护紧凑记忆。方法用GRPO结合任务驱动奖励训练，在在线与离线基准上均优于在线基线，并接近离线方法。", "tags": [], "reading_status": "complete"}, {"id": "arxiv:2609.37345", "title": "When to Retrieve, When to Stay: Uncertainty-Aware Temporal Evidence Allocation for Streaming Video-LLMs", "score": 9, "route": "20260723-20261020/2609.37345v1", "published": "2026-09-29", "publication_date": "2026-09-29", "publication_date_precision": "day", "publication_date_source": "https://arxiv.org/pdf/2609.37345v1", "publication_date_kind": "arxiv_first_submission", "zh_title": "", "summary":